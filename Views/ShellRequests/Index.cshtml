@model IEnumerable<UpgradePortal.Web.Models.ShellRequest>
@{
    ViewData["Title"] = "Shell Requests";
    Layout = "_Layout";

    string sortField = ViewBag.SortField ?? "date";
    string sortOrder = ViewBag.SortOrder ?? "desc";

    string NextOrder(string field) =>
        sortField == field && sortOrder == "asc" ? "desc" : "asc";

    string GetSortIcon(string field) =>
        sortField == field ? (sortOrder == "asc" ? " ↑" : " ↓") : " ↕";
}

<style>
    #shellRequestsTable {
        table-layout: auto;
        min-width: 1500px;
    }

        #shellRequestsTable th,
        #shellRequestsTable td {
            white-space: nowrap;
            vertical-align: middle;
        }

        #shellRequestsTable th {
            text-align: left;
        }

            #shellRequestsTable th.text-center {
                text-align: center;
            }

        #shellRequestsTable tbody td {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #shellRequestsTable th a {
            text-decoration: none;
            color: inherit;
            font-weight: 600;
        }

            #shellRequestsTable th a:hover {
                text-decoration: underline;
            }

    .actions-group {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: nowrap;
    }

        .actions-group form {
            margin: 0;
        }

        .actions-group .btn {
            white-space: nowrap;
        }

    .page-header {
        display: flex !important;
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: nowrap !important;
        margin-bottom: 1rem;
    }

    /* CONFIRM MODAL */
    .confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(15, 23, 42, 0.6);
        justify-content: center;
        align-items: center;
    }

        .confirm-overlay.active {
            display: flex;
        }

    .confirm-box {
        background: #fff;
        border-radius: 14px;
        padding: 32px;
        width: 380px;
        max-width: 90%;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        animation: fadeSlideIn 0.18s ease;
    }

    .confirm-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 16px;
    }

        .confirm-icon.success {
            background: #dcfce7;
            color: #16a34a;
        }

        .confirm-icon.warning {
            background: #fef3c7;
            color: #d97706;
        }

    .confirm-box h4 {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
    }

    .confirm-box p {
        margin: 0 0 24px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.5;
    }

    .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    body.dark-theme .confirm-box {
        background: #1e293b;
        color: #e5e7eb;
    }

        body.dark-theme .confirm-box h4 {
            color: #f1f5f9;
        }

        body.dark-theme .confirm-box p {
            color: #94a3b8;
        }
</style>

<!-- Confirm Modal -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box">
        <div class="confirm-icon" id="confirmIcon"></div>
        <h4 id="confirmTitle"></h4>
        <p id="confirmMessage"></p>
        <div class="confirm-actions">
            <button class="btn btn-sm btn-secondary" id="confirmCancel">Cancel</button>
            <button class="btn btn-sm" id="confirmOk">Confirm</button>
        </div>
    </div>
</div>

<div class="container-fluid py-4">
    <div class="page-header">
        <div>
            <h2 class="mb-1 fw-bold">Shell Requests</h2>
            <p class="text-muted mb-0">Manage and track shell request submissions.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 text-nowrap flex-shrink-0">
            + New Shell Request
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-5">
                    <input type="text"
                           id="shellRequestSearch"
                           class="form-control"
                           placeholder="Search by customer, clinic, customer ID, profile version..." />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table id="shellRequestsTable" class="table table-hover align-middle mb-0 w-100">
                <colgroup>
                    <col style="width: 60px;" />
                    <col style="width: 180px;" />
                    <col style="width: 130px;" />
                    <col style="width: 220px;" />
                    <col style="width: 120px;" />
                    <col style="width: 130px;" />
                    <col style="width: 150px;" />
                    <col style="width: 180px;" />
                    <col style="width: 120px;" />
                    <col style="width: 250px;" />
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="id"
                               asp-route-sortOrder="@(NextOrder("id"))">
                                ID @(GetSortIcon("id"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="customer"
                               asp-route-sortOrder="@(NextOrder("customer"))">
                                Customer Name @(GetSortIcon("customer"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="customerid"
                               asp-route-sortOrder="@(NextOrder("customerid"))">
                                Customer ID @(GetSortIcon("customerid"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="clinic"
                               asp-route-sortOrder="@(NextOrder("clinic"))">
                                Clinic Name @(GetSortIcon("clinic"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="profileversion"
                               asp-route-sortOrder="@(NextOrder("profileversion"))">
                                Profile Version @(GetSortIcon("profileversion"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="date"
                               asp-route-sortOrder="@(NextOrder("date"))">
                                Expected Date @(GetSortIcon("date"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="clientregistry"
                               asp-route-sortOrder="@(NextOrder("clientregistry"))">
                                Client Registry @(GetSortIcon("clientregistry"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="submittedby"
                               asp-route-sortOrder="@(NextOrder("submittedby"))">
                                Submitted By @(GetSortIcon("submittedby"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortField="status"
                               asp-route-sortOrder="@(NextOrder("status"))">
                                Status @(GetSortIcon("status"))
                            </a>
                        </th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ShellRequestId</td>
                            <td>@item.Customer?.CustomerName</td>
                            <td>@item.Customer?.CustomerCode</td>
                            <td>@item.ClinicName</td>
                            <td>@item.ProfileVersion</td>
                            <td>@item.ExpectedDate?.ToString("yyyy-MM-dd")</td>
                            <td>@item.ClientRegistry</td>
                            <td>@item.CreatedByUser?.FullName</td>
                            <td>
                                @if (item.Status == "completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        Completed
                                    </span>
                                }
                                else if (item.Status == "cancelled")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                        Pending
                                    </span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="actions-group">
                                    <a asp-action="Details"
                                       asp-route-id="@item.ShellRequestId"
                                       class="btn btn-sm btn-primary">
                                        View
                                    </a>

                                    @if (item.Status == "pending")
                                    {
                                        <form asp-action="Complete"
                                              asp-route-id="@item.ShellRequestId"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-sm btn-success confirm-btn"
                                                    data-title="Mark as Completed"
                                                    data-message="Are you sure you want to mark this shell request as completed? This action cannot be undone."
                                                    data-type="success"
                                                    data-icon="✓">
                                                Complete
                                            </button>
                                        </form>

                                        <form asp-action="Cancel"
                                              asp-route-id="@item.ShellRequestId"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-sm btn-warning text-dark confirm-btn"
                                                    data-title="Cancel Request"
                                                    data-message="Are you sure you want to cancel this shell request? This action cannot be undone."
                                                    data-type="warning"
                                                    data-icon="!">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No actions</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Search
            const searchInput = document.getElementById("shellRequestSearch");
            searchInput.addEventListener("keyup", function () {
                const search = this.value.toLowerCase();
                const rows = document.querySelectorAll("#shellRequestsTable tbody tr");
                rows.forEach(row => {
                    row.style.display = row.innerText.toLowerCase().includes(search) ? "" : "none";
                });
            });

            // Custom confirm modal
            const overlay = document.getElementById("confirmOverlay");
            const confirmTitle = document.getElementById("confirmTitle");
            const confirmMessage = document.getElementById("confirmMessage");
            const confirmIcon = document.getElementById("confirmIcon");
            const confirmOk = document.getElementById("confirmOk");
            const confirmCancel = document.getElementById("confirmCancel");

            let pendingForm = null;

            document.querySelectorAll(".confirm-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    pendingForm = this.closest("form");

                    const type = this.dataset.type;
                    confirmTitle.textContent = this.dataset.title;
                    confirmMessage.textContent = this.dataset.message;
                    confirmIcon.textContent = this.dataset.icon;
                    confirmIcon.className = "confirm-icon " + type;

                    confirmOk.className = "btn btn-sm " + (type === "success" ? "btn-success" : "btn-warning text-dark");
                    confirmOk.textContent = type === "success" ? "Yes, Complete" : "Yes, Cancel";

                    overlay.classList.add("active");
                });
            });

            confirmOk.addEventListener("click", function () {
                if (pendingForm) {
                    pendingForm.submit();
                }
                overlay.classList.remove("active");
            });

            confirmCancel.addEventListener("click", function () {
                overlay.classList.remove("active");
                pendingForm = null;
            });

            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove("active");
                    pendingForm = null;
                }
            });
        });
    </script>
}