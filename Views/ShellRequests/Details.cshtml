@model UpgradePortal.Web.Models.ShellRequest
@{
    ViewData["Title"] = "Shell Request Details";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Shell Request Details</h3>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Customer:</strong>
                    <div>@Model.Customer?.CustomerName</div>
                </div>
                <div class="col-md-6">
                    <strong>Clinic Name:</strong>
                    <div>@Model.ClinicName</div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Email:</strong>
                    <div>@Model.Email</div>
                </div>
                <div class="col-md-6">
                    <strong>Phone:</strong>
                    <div>@Model.Phone</div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Region:</strong>
                    <div>@Model.Region</div>
                </div>
                <div class="col-md-6">
                    <strong>Expected Date:</strong>
                    <div>@Model.ExpectedDate?.ToString("yyyy-MM-dd")</div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Profile Version:</strong>
                    <div>@Model.ProfileVersion</div>
                </div>
                <div class="col-md-6">
                    <strong>Client Registry:</strong>
                    <div>@Model.ClientRegistry</div>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Number of Users:</strong>
                    <div>@Model.NumUsers</div>
                </div>
                <div class="col-md-4">
                    <strong>IH Servers:</strong>
                    <div>@Model.NumIHServers</div>
                </div>
                <div class="col-md-4">
                    <strong>Dedicated Servers:</strong>
                    <div>@Model.NumDedicatedServers</div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Total Servers:</strong>
                    <div>@Model.TotalServers</div>
                </div>
                <div class="col-md-4">
                    <strong>Status:</strong>
                    <div>@Model.Status</div>
                </div>
                <div class="col-md-4">
                    <strong>Created At:</strong>
                    <div>@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>

            <div class="mb-3">
                <strong>Integrations:</strong>
                <div>@Model.Integrations</div>
            </div>

            <div class="mb-3">
                <strong>Attachments:</strong>
                <div>@Model.Attachments</div>
            </div>

            <div class="mb-3">
                <strong>Notes:</strong>
                <div>@Model.Notes</div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>